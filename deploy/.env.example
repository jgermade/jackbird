# jackbird with Docker Compose: copy to .env and edit.

# The user jackbird runs as: who owns the folders below (run `id -u` and `id -g`).
JACKBIRD_USER=1000:1000

# Where the configuration (people, settings) and the library live on this machine.
JACKBIRD_CONFIG=./config
JACKBIRD_LIBRARY=./library
# Your music, to import from (read only).
MUSIC=/path/to/your/music

# restic (docker compose --profile backup up -d): a repository and its password.
RESTIC_PASSWORD=change-me
# A folder on this machine (a USB disk mounted elsewhere is better), or a storage service:
RESTIC_LOCAL=./restic
# RESTIC_REPOSITORY=b2:my-bucket:jackbird
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# With Caddy in front (see compose.yaml): your instance's address.
# JACKBIRD_ADDRESS=music.example.com
